      <!-- ================================================================== -->
      <!-- THREAD GROUP 2: Account & Auth Lifecycle (APIs 7-14)               -->
      <!-- ================================================================== -->
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="TG2 - Account &amp; Auth Lifecycle (APIs 7-14)" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${__P(acc.loops,1)}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(acc.threads,2)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(acc.rampup,4)}</stringProp>
